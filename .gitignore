.venv/
__pycache__/
*.pyc

# Local PoC scratch
poc-output.txt
poc-sample.json

# Stray top-level scratch outputs (real runs write into <year>/ which is tracked)
/questions*.csv
/answers*.csv
/*.json

# Un-ignore the extension icon dir: the global macOS `Icon?` rule matches
# `icons` case-insensitively on macOS and would otherwise drop it.
!extension/icons/

# Incremental-refresh high-water mark (persisted via Actions cache, not git)
/.refresh-hwm

# Month-backfill failure log (local record of dates to redo)
/backfill-failures.txt

# iCloud / cloud-sync conflict copies (e.g. "questions-... 2.csv"). Real data
# filenames never contain a space, so this is unambiguous and stops the blanket
# `git add <year>/` from ever staging sync junk again.
* *.csv
